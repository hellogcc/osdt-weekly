{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- /* 自定义 RSS：频道信息用站点级文案，条目只取期号页面，guid 用不随域名变化的稳定标识。 */ -}}
{{- $pages := where site.RegularPages "Section" "issue" -}}
{{- if not .IsHome -}}{{- $pages = .RegularPagesRecursive -}}{{- end -}}
{{- $pages = $pages.ByDate.Reverse -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if gt $limit 0 -}}{{- $pages = first $limit $pages -}}{{- end -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Params.siteName }} · {{ site.Params.siteNameCN }}</title>
    <link>{{ site.Home.Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <language>zh-cn</language>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    <generator>Hugo</generator>
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="false">{{ with .Params.issue }}osdt-weekly-issue-{{ . }}{{ else }}osdt-weekly-{{ .File.ContentBaseName }}{{ end }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      {{- with .Params.sections }}
      {{- range split . " · " }}
      <category>{{ . }}</category>
      {{- end }}
      {{- end }}
      <description>{{ .Content | html }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
